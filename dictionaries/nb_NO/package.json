{
  "name": "@cspell/dict-nb-no",
  "version": "2.0.9",
  "description": "Norwegian Bokmål dictionary for cspell.",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "cspell",
    "cspell-ext",
    "nb_NO",
    "Norwegian Bokmål",
    "dictionary",
    "spelling"
  ],
  "homepage": "https://github.com/streetsidesoftware/cspell-dicts/blob/main/dictionaries/nb_NO#readme",
  "bugs": {
    "url": "https://github.com/streetsidesoftware/cspell-dicts/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/streetsidesoftware/cspell-dicts",
    "directory": "dictionaries/nb_NO"
  },
  "license": "GPL-3.0-or-later",
  "author": "Street Side Software <support@streetsidesoftware.nl>",
  "contributors": [
    "Steffen Holanger (https://github.com/spiftire)",
    "Eirik Vågeskar (https://github.com/Vages)"
  ],
  "exports": {
    ".": "./cspell-ext.json",
    "./cspell": "./cspell-ext.json",
    "./cspell-ext.json": "./cspell-ext.json"
  },
  "files": [
    "dict/nb-no.trie.gz",
    "cspell-ext.json",
    "*.js",
    "*.d.ts",
    "src/hunspell/dictionaries/nb/license",
    "src/hunspell/dictionaries/nb/readme.md",
    "src/LibreOffice/no/README",
    "src/LibreOffice/no/COPYING"
  ],
  "scripts": {
    "build": "cspell-tools-cli build",
    "conditional-build": "pnpm run sync && cspell-tools-cli build --conditional",
    "prepare:dictionary": "cspell-tools-cli gzip \"dict/nb-no.trie\"",
    "prepublishOnly": "echo OK",
    "sync": "pnpm run sync:hunspell && pnpm run sync:LibreOffice",
    "sync:hunspell": "sync-github-files wooorm/dictionaries --filter \"dictionaries/nb/index.aff\" --filter \"dictionaries/nb/index.dic\" --filter \"dictionaries/nb/license\" --filter \"dictionaries/nb/readme.md\" --tag=main -o src/hunspell",
    "sync:LibreOffice": "sync-github-files LibreOffice/dictionaries --filter \"no/nb_NO.dic\" --filter \"no/nb_NO.aff\" --filter \"no/README\" --filter \"no/COPYING\" --tag=master -o src/LibreOffice",
    "test": "cspell samples"
  },
  "dependencies": {},
  "devDependencies": {}
}
