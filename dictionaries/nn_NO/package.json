{
  "name": "@cspell/dict-nn-no",
  "version": "0.0.1-alpha.0",
  "private": true,
  "description": "Norwegian Nynorsk dictionary for cspell. -- Private until verified",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "cspell",
    "cspell-ext",
    "nn_NO",
    "Norwegian Nynorsk",
    "dictionary",
    "spelling"
  ],
  "homepage": "https://github.com/streetsidesoftware/cspell-dicts/blob/main/dictionaries/nn_NO#readme",
  "bugs": {
    "url": "https://github.com/streetsidesoftware/cspell-dicts/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/streetsidesoftware/cspell-dicts",
    "directory": "dictionaries/nn_NO"
  },
  "license": "GPL-3.0-or-later",
  "author": "Street Side Software <support@streetsidesoftware.nl>",
  "contributors": [
    "Eirik Vågeskar (https://github.com/Vages)"
  ],
  "exports": {
    ".": "./cspell-ext.json",
    "./cspell": "./cspell-ext.json",
    "./cspell-ext.json": "./cspell-ext.json"
  },
  "files": [
    "dict/nn-no.trie.gz",
    "cspell-ext.json",
    "*.js",
    "*.d.ts",
    "src/hunspell/dictionaries/nn/license",
    "src/hunspell/dictionaries/nn/readme.md"
  ],
  "scripts": {
    "build": "cspell-tools-cli build",
    "conditional-build": "pnpm run sync && cspell-tools-cli build --conditional",
    "prepare:dictionary": "cspell-tools-cli gzip \"dict/nn-no.trie\"",
    "prepublishOnly": "echo OK",
    "sync": "sync-github-files wooorm/dictionaries --filter \"dictionaries/nn/index.aff\" --filter \"dictionaries/nn/index.dic\" --filter \"dictionaries/nn/license\" --filter \"dictionaries/nn/readme.md\" --tag=main -o src/hunspell",
    "test": "cspell samples"
  },
  "dependencies": {},
  "devDependencies": {}
}
