{
  "name": "@cspell/dict-be-by",
  "version": "1.0.0",
  "description": "Belarusian dictionary for cspell.",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": "./cspell-ext.json",
    "./cspell": "./cspell-ext.json",
    "./cspell-ext.json": "./cspell-ext.json"
  },
  "scripts": {
    "build": "cspell-tools-cli build --conditional",
    "test": "pnpm run test:src && pnpm run test:samples",
    "test:samples": "cspell samples",
    "test:src": "hunspell-reader words -n 1000 -m 0 \"src/hunspell/be-BY.dic\" | cspell -c ./cspell-ext.json \"--locale=be, be-BY\" \"--languageId=*\" stdin",
    "gz": "cspell-tools-cli gzip \"dict/be-by.trie\"",
    "prepare:dictionary": "pnpm run gz",
    "prepublishOnly": "echo OK"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/streetsidesoftware/cspell-dicts"
  },
  "keywords": [
    "cspell",
    "cspell-ext",
    "be_BY",
    "Belarusian",
    "dictionary",
    "spelling"
  ],
  "author": "Street Side Software",
  "contributors": [
    "Aliiaksandr 'Ueschar' Mikhaleu"
  ],
  "license": "CC BY-SA 4.0",
  "bugs": {
    "url": "https://github.com/streetsidesoftware/cspell-dicts/issues"
  },
  "homepage": "https://github.com/streetsidesoftware/cspell-dicts/blob/main/dictionaries/be_BY#readme",
  "devDependencies": {},
  "dependencies": {},
  "files": [
    "dict/be-by.trie.gz",
    "cspell-ext.json",
    "*.js",
    "*.d.ts"
  ]
}