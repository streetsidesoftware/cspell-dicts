{
  "name": "cspell-dicts",
  "version": "35.1.1",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "test": "pnpm -r run --workspace-concurrency 2 --stream test",
    "test:packages": "pnpm -r run test:package",
    "lint": "pnpm run lint:fix && pnpm run check:types && cspell --no-progress",
    "lint-ci": "eslint . && prettier -c . && pnpm run check:types && cspell --no-progress",
    "lint:fix": "eslint --fix . && prettier -w .",
    "build": "pnpm run setup && pnpm run build:conditional",
    "build:all": "pnpm -r run --stream --workspace-concurrency 2 --no-bail build",
    "build:readme": "pnpm run readme:generate-doc-dictionaries && pnpm run readme:inject",
    "build:conditional": "pnpm -r run --workspace-concurrency 2 --stream --no-bail build:conditional && pnpm -r run --workspace-concurrency 2 --stream --no-bail conditional-build",
    "lint:fix:sort-source-files": "sort-source -c sort-source.config.json",
    "sort": "pnpm lint:fix:sort-source-files",
    "conditional-build": "pnpm build:conditional",
    "check-dirty": "git --no-pager diff --compact-summary --exit-code",
    "check-spelling": "cspell",
    "check:types": "tsc -p .",
    "checksum": "pnpm -r run checksum",
    "gen:release-please-config": "gen-release-please-config",
    "check:release-please-config": "gen-release-please-config --check",
    "release-as": "release-as",
    "prepare-publication": "prepare-publication",
    "clean": "shx rm -rf \"packages/*/*.txt.gz\" \"dictionaries/*/*.txt.gz\"",
    "readme:generate-doc-dictionaries": "gen-dictionary-info",
    "readme:inject": "inject-markdown \"*.md\" \"dictionaries/*/README.md\" \"dictionaries/*/samples/README.md\" \"dictionaries/*/src/README.md\" && pnpm run readme:format",
    "readme:format": "fix-readme-markdown && prettier -w --ignore-unknown \"*.md\" \"dictionaries/*/README.md\" \"dictionaries/*/src/README.md\" \"dictionaries/*/static/*\"",
    "prepublishOnly": "pnpm prepare:dictionaries",
    "prepare:dictionaries": "pnpm -r run --stream --workspace-concurrency 3 prepare:dictionary",
    "setup": "pnpm i && pnpm prepare:dictionaries",
    "setup-repo": "pnpm run setup",
    "pub-recover": "lerna publish from-package --no-push --no-private --concurrency 1",
    "trusted-publishing": "trusted-publishing",
    "#update-dictionaries": "# Update dictionaries will run the update-dictionary script in each dictionary package.",
    "update-dictionaries": "pnpm -r run --stream --workspace-concurrency 2 update-dictionary",
    "update:contributors": "update-contributors",
    "update-packages": "pnpm up",
    "preinstall": "npx only-allow pnpm"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/streetsidesoftware/cspell-dicts.git"
  },
  "devDependencies": {
    "@cspell/cspell-tools": "^10.4.1",
    "@cspell/dict-cspell-bundle": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@internal/create-dictionary": "workspace:^",
    "@lerna-lite/cli": "^5.8.0",
    "@lerna-lite/exec": "^5.8.0",
    "@lerna-lite/publish": "^5.8.0",
    "@lerna-lite/run": "^5.8.0",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^26.6.6",
    "ava": "^8.4.0",
    "cpy-cli": "^7.0.0",
    "cross-env": "^10.1.0",
    "cspell": "^10.4.1",
    "cspell-dict-file-checker": "workspace:^",
    "cspell-dicts-scripts": "workspace:*",
    "cspell-trie": "^10.4.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "hunspell-reader": "^10.4.1",
    "inject-markdown": "^6.3.0",
    "json5": "2.2.3",
    "prettier": "^3.9.10",
    "shx": "^0.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "yamljs": "^0.3.0"
  },
  "engines": {
    "node": ">=22.19"
  },
  "license": "GPL-3.0-or-later"
}
